    final mug = Mug(volumeMl: 300, initialMl: 200);
    final person = Person('Чибук');
    print(mug);
    person.drinkFrom(mug, 150);
    person.drinkFrom(mug, 100);
    mug.fill(250);
    print('После долива: $mug');

    print('\nШкаф');
    final wardrobe = Wardrobe([
      StorageSystem('Полка'),
      StorageSystem('Ящик'),
    ]);
    wardrobe.putItem('Футболка');
    wardrobe.putItem('Носки');
    wardrobe.show();
    print('Забрать "Носки": ${wardrobe.takeItem("Носки")}');
    wardrobe.show();

    print('\nГриф и блины');
    final bar = BarbellBar(maxLoadKg: 60.0);
    print('Добавить слева 20кг: ${bar.addLeft(Plate(20))}');
    print('Добавить справа 20кг: ${bar.addRight(Plate(20))}');
    print('Добавить справа 30кг (перегруз): ${bar.addRight(Plate(30))}');
    print(bar);

    print('\nКонвертация валют');
    final converter = MoneyConverter(
      base: 'USD',
      ratesToBase: {
        'USD': 1.0,
        'EUR': 1.1,
        'RUB': 0.011, 
      },
    );
    double rubToEur = converter.convert(1000, 'RUB', 'EUR');
    print('10000 RUB -> EUR = ${rubToEur.toStringAsFixed(2)}');

    print('\nПерегрузка операций');
    final a = MyNumber(10);
    final b = MyNumber(3);
    print('a+b = ${a + b}');
    print('a-b = ${a - b}');
    print('a*b = ${a * b}');
    print('a/b = ${(a / b)}');
    print('-a = ${-a}');

    print('\nАвтомобиль(enum состояния)');
    final car = Car();
    print(car);
    car.go();
    print(car);
    car.turnLeft();
    print(car);
    car.stop();
    print(car);

    print('\nФигуры');
    final r = Rectangle(4, 5);
    final t = Triangle(6, 3);
    final c = Circle(2);
    print('${r.name()} area=${r.area()}');
    print('${t.name()} area=${t.area()}');
    print('${c.name()} area=${c.area().toStringAsFixed(2)}');

    print('\nСистемы счисления');
    final baseConv = BaseConverter();
    print('255 (10) -> (16) = ${baseConv.convert("255", 10, 16)}');
    print('FF (16) -> (8) = ${baseConv.convert("FF", 16, 8)}');

    print('\nМаксимальная площадь');
    final shapeList = ShapeList();
    shapeList.add(Rectangle(2, 10)); 
    shapeList.add(Circle(3));        
    shapeList.add(Triangle(10, 4));  
    final best = shapeList.maxAreaShape();
    if (best != null) {
      print('Максимальная площадь у: ${best.name()}, area=${best.area()}');
    }

    print('\nСтол и приборы');
    final table = Table();
    table.put(Fork());
    table.put(Spoon());
    table.put(Knife());
    table.show();
    print('Убрать "Штопр": ${table.removeByName("Штопр")}');
    table.show();
  }
